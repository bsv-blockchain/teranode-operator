# ================================================================================================
# 🏗️ PROJECT CONFIGURATION (90-project.env)
# ================================================================================================
#
# Purpose: Project-specific overrides for teranode-operator
# Load Order: 90 (loaded near-last, overrides all defaults from 00-xx files)
#
# This file contains project-specific configuration that overrides the shared defaults.
# Only values that differ from the defaults need to be listed here.
#
# Migrated from: .github/.env.custom
#
# ================================================================================================

# ================================================================================================
# 🎯 GO VERSION CONFIGURATION
# ================================================================================================

# Primary Go version (overrides 00-core.env)
GO_PRIMARY_VERSION=1.26.x

# Secondary Go version (overrides 00-core.env)
GO_SECONDARY_VERSION=1.26.x

# Mage-X Go versions (overrides 10-mage-x.env)
MAGE_X_GO_VERSION=1.26.x
MAGE_X_GO_SECONDARY_VERSION=1.26.x

# ================================================================================================
# ✨ FEATURE FLAGS (overrides 00-core.env)
# ================================================================================================

# Disable fuzzing and race detection (this repo uses custom testing strategies)
ENABLE_FUZZ_TESTING=false
ENABLE_RACE_DETECTION=false
ENABLE_GO_TESTS=false

# Disable cache warming to reduce memory usage
ENABLE_CACHE_WARMING=false

# ================================================================================================
# 📊 COVERAGE CONFIGURATION (overrides 10-coverage.env)
# ================================================================================================

# Provider
GO_COVERAGE_PROVIDER=codecov

# Codecov Configuration (only used when provider=codecov)
CODECOV_TOKEN_REQUIRED=true

# Coverage exclusions matching codecov.yml ignore paths
GO_COVERAGE_EXCLUDE_PATHS=test/,vendor/,testdata/,.github/,.mage-cache/,.vscode/,bin/,example/,examples/,mocks/,testing/

# ================================================================================================
# 🏗️ MAGE-X BUILD CONFIGURATION (overrides 10-mage-x.env)
# ================================================================================================

# Exclude test packages from cache warming to reduce memory usage
MAGE_X_BUILD_EXCLUDE_PATTERN=*/test/*

# Use incremental build strategy with small batches for memory safety
MAGE_X_BUILD_STRATEGY=incremental

# Build in very small batches to avoid OOM on GitHub Actions runners
MAGE_X_BUILD_BATCH_SIZE=2

# Add delay between batches to allow memory cleanup
MAGE_X_BUILD_BATCH_DELAY_MS=200

# Limit parallelism to 1 for maximum memory safety
MAGE_X_PARALLEL=1

# ================================================================================================
# 🔒 SECURITY CONFIGURATION (overrides 10-security.env)
# ================================================================================================

# Nancy CVE Exclusions
NANCY_EXCLUDES=CVE-2025-62725,CVE-2024-21626,CVE-2024-45310,CVE-2026-33817,CVE-2026-39883
